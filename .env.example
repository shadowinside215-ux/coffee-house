# Firebase Configuration (Required for cloud persistence & Auth)
# Obtain these from your Firebase Console (Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="dar-al-qahwa.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="dar-al-qahwa"
VITE_FIREBASE_STORAGE_BUCKET="dar-al-qahwa.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Cloudinary Configuration (For media storage & real-time transformations)
# Obtain from your Cloudinary Dashboard
VITE_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="dar_al_qahwa_preset"

# Application Base URL
APP_URL="https://dar-al-qahwa.vercel.app"
